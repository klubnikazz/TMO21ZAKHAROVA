def minutes_per_lap(minutes, laps):
    if laps == 0:
        return "На ноль делить нельзя"
    return minutes / laps

assert minutes_per_lap(40, 5) == 8.0
assert minutes_per_lap(40, 0) == "На ноль делить нельзя"
assert minutes_per_lap(70, 5) == 14.0

